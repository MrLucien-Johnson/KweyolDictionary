{
  "name": "kweyol-dictionary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run content:publish && next build",
    "build:pages": "npm run content:publish && node scripts/prepare-pages-build.mjs && node scripts/run-pages-build.mjs",
    "start": "next start",
    "start:pages": "npx --yes serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "content:report": "tsx scripts/content-coverage.ts",
    "content:publish": "tsx scripts/publish-static-content.ts",
    "content:tts": "python3 scripts/generate-tts-audio.py",
    "content:audio": "npm run content:publish && npm run content:tts && npm run content:publish",
    "content:accept-audio": "node scripts/accept-community-audio.mjs",
    "postinstall": "prisma generate",
    "validate": "prisma generate && npm run content:publish && npm run lint && npm run typecheck && npm run test && npm run db:validate && next build",
    "validate:pages": "npm run validate && npm run build:pages"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
